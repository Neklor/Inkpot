# Maintainer: Christoph Krogmann <ch.krogmann@outlook.de>

pkgname=inkpot
pkgver=1.1.3
pkgrel=1
pkgdesc="A paint program where everything you draw stays an object"
arch=('x86_64')
url="https://github.com/Neklor/Inkpot"
license=('GPL-3.0-only')

# qt6-base carries Core, Gui, Widgets, PrintSupport and DBus, which is
# everything the binary links against besides libheif and the system
# libraries. hicolor-icon-theme owns the directory the icon goes into.
depends=('qt6-base' 'libheif' 'hicolor-icon-theme')

# qt6-tools brings lrelease and the CMake package for it, without which the
# translations would not be built.
makedepends=('cmake' 'ninja' 'qt6-tools')

optdepends=('qt6-imageformats: export to TIFF and WebP')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a761f2cda87857bee9a1353e5b1ec3201fee6d30fdc69fdc9976fbb2d918a77c')

build() {
    cmake -S "Inkpot-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "Inkpot-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
